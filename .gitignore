# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tmp-next-dev*

# Generated local-only development routes
src/app/dev/level-editor/page.tsx
src/app/dev/dungeon-crawl/page.tsx
src/app/dev/hub-preview/page.tsx

# THE TUNING FINALE — visual capture output (regenerate with `npm run capture`)
.captures/
test-results/
playwright-report/

DOCS/ADD2ndEdition/*

